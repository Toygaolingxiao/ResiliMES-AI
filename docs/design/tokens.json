  "chrome_vs_chart": {
    "$note": "Owner decision #1 boundary list for timeline (and any canvas page).",
    "chrome": [
      "page background",
      "top bar / brand / back",
      "typography / IBM Plex",
      "form controls / buttons / focus ring",
      "axis labels and tick text",
      "grid lines",
      "tooltip / detail panel chrome",
      "theme toggle / language switch"
    ],
    "chart_data": [
      "gantt bar fills",
      "heatmap cells",
      "swimlane category colours",
      "legend swatches that encode data series"
    ],
    "rules": [
      "Chrome converges to the site system in Wave 3a.",
      "Chart data colours stay on the chart palette; light/dark each have a set.",
      "Canvas reads CSS variables at runtime, caches, and redraws on theme change (Wave 1c).",
      "Chart colours need a non-colour redundant cue (pattern/label) where they carry meaning."
    ]
  },
