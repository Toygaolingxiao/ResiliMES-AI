# =============================================================================
# ResiliMES — environment template (copy to .env and fill in values)
# Never commit real secrets. All credentials stay in .env only.
# =============================================================================

# --- Zetaris (Data layer) ---
# Web UI origin (no path). Used by smoke_test "Zetaris Web" check.
ZETARIS_BASE_URL=https://your-org.zetaris.com

# Direct REST API base ending in /api/v1.0
ZETARIS_REST_URL=https://api.enterprise.zetaris.com/api/v1.0

# Numeric organisation ID (Management → Organisation → ID)
ZETARIS_ORG_ID=1

# API key created in Management → API Tokens (Bearer auth)
ZETARIS_API_KEY=

# Optional UI-proxy login fallback (if API key unset)
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=

# SQL run path under the REST base (hackathon default: /sql-editor/sqls/run)
# Some Zetaris tenants use /sql-editor/sqls/run-query — override if needed.
ZETARIS_SQL_PATH=/sql-editor/sqls/run

# Optional query helpers
ZETARIS_QUERY_LIMIT=1000
# ZETARIS_ENGINE_ID=

# --- Meterless Nightshift / NVIDIA Nemotron (Power layer) ---
# OpenAI-compatible base URL, typically http://127.0.0.1:8088/v1
METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# Runtime token from Nightshift (<stateDir>/proxy-token). Not the placeholder rt-local.
METERLESS_RUNTIME_TOKEN=

# Model / routing id served by Nightshift (e.g. nvidia Nemotron or meterless/auto)
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2

# Stable app id sent as meterless-app header
METERLESS_APP_ID=resilimes

# Request timeout seconds (model load can be slow on first call)
METERLESS_TIMEOUT_S=180
