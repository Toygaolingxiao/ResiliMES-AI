# =============================================================================
# ResiliMES — environment template
# Copy to .env and fill in values. Never commit .env or real secrets.
# =============================================================================

# auto  — Nightshift if METERLESS_RUNTIME_TOKEN is set, Zetaris if the API key
#         is set, offline twins otherwise. This is the default.
# mock  — force the offline twins. `make demo` sets this.
# live  — require both providers and fail at startup if a credential is missing.
RESILIMES_MODE=auto

# Console bind address. `make demo` listens on 0.0.0.0:8000.
RESILIMES_HOST=0.0.0.0
RESILIMES_PORT=8000
RESILIMES_LOG_LEVEL=INFO

# Frozen scenario clock. Leave unset to use 2026-10-22T06:30:00Z, which matches
# the sample WIP snapshot. Plant time and contract TTL are different clocks.
# RESILIMES_HORIZON=2026-10-22T06:30:00Z
# RESILIMES_DATA_DIR=data/sample

# HMAC key for Scout execution contracts. The default is a local dev key, not a
# cloud credential. Set a private value before any shared deployment.
# SCOUT_SIGNING_SECRET=
# SCOUT_TTL_SECONDS=300

# --- Zetaris (data layer) ---
# Verified against the owner's local bundle on 2026-10-24.
# Next.js UI. Serves POST /api/auth/login and proxies /api/proxy/<path>.
ZETARIS_BASE_URL=http://localhost:3000

# REST API base. JDBC on port 10000 is not used.
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0

# Numeric organisation id. Required on every REST call as X-Org-ID.
# Login returns orgId 1. X-API-Key alone is rejected.
ZETARIS_ORG_ID=1

# Long-lived key from POST /auth/api-key. Sent as Authorization: Bearer.
# Leave blank here. scripts/zetaris_setup.sh stores the key outside the repo.
ZETARIS_API_KEY=

# SQL path under the REST base. /sql-editor/sqls/run accepts the same body.
ZETARIS_SQL_PATH=/sql-editor/sqls/run-query

# Datasource used for MES tables. maintenance_logs, bom, and materials are
# qualified with the map below. Other plant tables use this schema name.
ZETARIS_SCHEMA=resilimes
ZETARIS_QUERY_LIMIT=1000

# table=datasource pairs. Empty keeps the defaults in sql_catalog.
# Each datasource value must match ^[A-Za-z_][A-Za-z0-9_]*$.
ZETARIS_TABLE_SOURCES=maintenance_logs=fab_cmms,bom=fab_erp,materials=fab_erp

# REST read timeout in seconds. The recovery path and run_sql both honor it.
ZETARIS_TIMEOUT_S=30

# Optional. Empty keeps the in-memory StateStore. `make redis` listens here.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Meterless Nightshift / NVIDIA Nemotron (power layer) ---
# OpenAI-compatible base. A pasted URL with /v1, /v1/chat/completions,
# /v1/models, or /healthz is normalized to <origin>/v1.
# Windows with Hyper-V, WSL, or Docker may reserve 8001-8100, so 8088
# fails with listen EACCES. Reserve 8088 and 11435 from an elevated
# PowerShell (see README Troubleshooting). If Nightshift listens on
# another port, set this URL to match.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# Runtime token from Nightshift <stateDir>/proxy-token.
# The placeholder rt-local is rejected.
METERLESS_RUNTIME_TOKEN=

# Model id served by Nightshift. Confirm with GET /v1/models after Nemotron
# is installed. Routing ids such as meterless/auto are accepted by the client,
# but the hackathon asks for NVIDIA connected inside Nightshift, so prefer the
# Nemotron id your runtime lists.
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Completion budget. Reasoning models spend tokens before the answer.
# An empty body is retried once at twice this size.
NEMOTRON_MAX_TOKENS=4096

# Nightshift only explains. The critic is deterministic and has no model setting.

# Stable app id sent as the meterless-app header on every call.
METERLESS_APP_ID=resilimes

# First-token latency can include a model load.
METERLESS_TIMEOUT_S=180
# LLM_MAX_RETRIES=3
